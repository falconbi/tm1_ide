PAW_HOST=http://192.168.x.x
PAW_USERNAME=admin
PAW_PASSWORD=your_password
PAW_AUTH_MODE=native          # "native" (TM1 auth) or "authentik" (PAW V12 SSO)
PAW_LOGIN_SERVER=24Retail     # TM1 server configured as the PAW Login Server in the PAW admin console — users must exist here to log into PAW
PORT=8083

# ── Optional: AI-powered MDX / subset generation ─────────────────────────────
# Any configured provider enables the AI buttons. No single vendor is required.
#   AI_PROVIDER=anthropic | openai-compatible | gemini
#   AI_API_KEY=<key>                       (required — blank disables AI)
#   AI_MODEL=<model>                       (optional; provider-appropriate default)
#   AI_BASE_URL=<api base url>             (optional; openai-compatible & gemini)
#
#   AI_OBFUSCATE_NAMES=true                # hide real cube/dim/element names
#                                          # from the provider (opaque tokens,
#                                          # restored in the response)
#
# Examples:
#   Claude:         AI_PROVIDER=anthropic  AI_API_KEY=sk-ant-...
#   OpenAI:         AI_PROVIDER=openai-compatible  AI_API_KEY=sk-...  AI_MODEL=gpt-4o
#   Local Ollama:   AI_PROVIDER=openai-compatible  AI_API_KEY=ollama
#                   AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=qwen2.5-coder:14b
#   Local llama.cpp: AI_PROVIDER=openai-compatible  AI_API_KEY=none
#                   AI_BASE_URL=http://localhost:8080/v1  AI_MODEL=...
#
# Legacy: ANTHROPIC_API_KEY is still honoured as Claude if AI_PROVIDER is unset.
