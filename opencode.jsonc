{
  "$schema": "https://opencode.ai/config.json",

  // The TM1 IDE MCP server — one entry per TM1 server (it binds to one via --server).
  // Absolute paths so it works no matter which directory opencode launches from.
  "mcp": {
    "tm1-dev": {
      "type": "local",
      "command": ["node", "/home/jdlove/apps/tm1_ide/tools/tm1mcp/server.js", "--server", "TM1_Test_DEV"],
      "enabled": true
    },
    "tm1-prod": {
      "type": "local",
      "command": ["node", "/home/jdlove/apps/tm1_ide/tools/tm1mcp/server.js", "--server", "TM1_Test_PROD"],
      "enabled": true
    }
  }
}
