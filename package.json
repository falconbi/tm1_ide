{
  "name": "tm1_ide",
  "version": "1.0.0",
  "description": "Models-as-code tooling and IDE for IBM Planning Analytics (TM1).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "tm1deploy": "node tools/tm1deploy/bin/tm1deploy.js",
    "tm1mcp": "node tools/tm1mcp/server.js",
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "lens": "node lens-server.js",
    "lint": "eslint .",
    "lint:count": "eslint . --format json | node -e \"let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{const r=JSON.parse(d);console.log('lint problems:', r.reduce((a,f)=>a+f.messages.length,0))})\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "axios": "^1.16.1",
    "axios-cookiejar-support": "^6.0.5",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "js-yaml": "^4.1.1",
    "mssql": "^12.5.5",
    "mysql2": "^3.22.4",
    "pg": "^8.21.0",
    "tough-cookie": "^6.0.1",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
